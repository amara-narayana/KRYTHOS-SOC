# KRYTHOS SOC - Environment Configuration
APP_NAME="KRYTHOS SOC"
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Security & Secrets
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Database
DATABASE_URL=sqlite:///./data/krythos.db

# Storage & Retention
DATA_DIR=./data
LOG_RETENTION_DAYS=90
MAX_EVENT_BATCH_SIZE=1000
LOW_MEMORY_MODE=false

# Registration Policy: open | approval | disabled
REGISTRATION_POLICY=open

# Local AI (Ollama or compatible runtime)
AI_ENABLED=true
AI_PROVIDER=local_ollama
AI_ENDPOINT=http://127.0.0.1:11434
AI_MODEL=llama3:latest
AI_TIMEOUT_SECONDS=15
