[Unit]
Description=KRYTHOS SOC — Real-Time Production Security Operations Center Platform
Documentation=https://github.com/amara-narayana/KRYTHOS-SOC
After=network.target systemd-journald.service
Wants=systemd-journald.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/kali/KRYTHOS-SOC
Environment=PYTHONUNBUFFERED=1
Environment=ENVIRONMENT=production
Environment=ENABLE_LIVE_WATCHER=true
ExecStart=/home/kali/KRYTHOS-SOC/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 1 --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening & Permissions
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
